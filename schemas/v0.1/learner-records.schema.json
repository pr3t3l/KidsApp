{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kids-learning.local/schemas/v0.1/learner-records.schema.json",
  "title": "LearnerEvidenceRecords",
  "description": "Evidence sub-aggregate only. Learner profile, interests, and provisional preferences are intentionally outside this v0.1 contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "learnerId", "revision", "exposures", "observations", "inferences"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "learnerId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "exposures": { "type": "array", "items": { "$ref": "#/$defs/exposure" } },
    "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
    "inferences": { "type": "array", "items": { "$ref": "#/$defs/inference" } }
  },
  "$defs": {
    "localizedString": {
      "type": "object", "additionalProperties": false, "required": ["en-US", "es-US"],
      "properties": { "en-US": { "type": "string", "minLength": 1 }, "es-US": { "type": "string", "minLength": 1 } }
    },
    "activityRef": {
      "type": "object", "additionalProperties": false, "required": ["activityId", "version", "contentHash"],
      "properties": {
        "activityId": { "type": "string", "pattern": "^ACT-[0-9]{4}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "exposure": {
      "type": "object", "additionalProperties": false,
      "required": ["exposureId", "sessionId", "activityRef", "skillOrConceptId", "kind", "source", "roleTemplateIds", "occurredAt", "recordedAt", "clientEventId"],
      "properties": {
        "exposureId": { "type": "string", "pattern": "^EXP-[A-Z0-9-]+$" },
        "sessionId": { "type": "string", "pattern": "^SES-[A-Z0-9-]+$" },
        "activityRef": { "$ref": "#/$defs/activityRef" },
        "skillOrConceptId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["skill", "concept"] },
        "source": { "enum": ["role_actual", "step_actual", "adult_added"] },
        "roleTemplateIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^ROLE-[A-Z0-9-]+$" } },
        "occurredAt": { "type": "string", "format": "date-time" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "clientEventId": { "type": ["string", "null"] }
      }
    },
    "observationContext": {
      "type": "object", "additionalProperties": false,
      "required": ["activityRef", "roleTemplateIds", "contextFlags", "supportDescription"],
      "properties": {
        "activityRef": { "$ref": "#/$defs/activityRef" },
        "roleTemplateIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^ROLE-[A-Z0-9-]+$" } },
        "contextFlags": { "type": "array", "uniqueItems": true, "items": { "enum": ["equipment_problem", "material_problem", "group_dependency", "fatigue", "interruption", "other"] } },
        "supportDescription": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["createdBy", "adultId", "inputRef", "aiAssisted", "providerDeploymentId", "clientEventId"],
      "properties": {
        "createdBy": { "enum": ["adult", "system", "ai_companion"] },
        "adultId": { "type": ["string", "null"] },
        "inputRef": { "type": ["string", "null"] },
        "aiAssisted": { "type": "boolean" },
        "providerDeploymentId": { "type": ["string", "null"] },
        "clientEventId": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "aiAssisted": { "const": true } }, "required": ["aiAssisted"] },
          "then": { "properties": { "providerDeploymentId": { "type": "string", "minLength": 1 } } },
          "else": { "properties": { "providerDeploymentId": { "type": "null" } } }
        },
        {
          "if": { "properties": { "createdBy": { "const": "adult" } }, "required": ["createdBy"] },
          "then": { "properties": { "adultId": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observationId", "sessionId", "skillId", "source", "status", "independenceRating", "fact", "context", "occurredAt", "createdAt", "revision", "supersedesObservationId", "correctionReason", "rejectionReason", "provenance"],
      "properties": {
        "observationId": { "type": "string", "pattern": "^OBS-[A-Z0-9-]+$" },
        "sessionId": { "type": "string", "pattern": "^SES-[A-Z0-9-]+$" },
        "skillId": { "type": "string", "minLength": 1 },
        "source": { "enum": ["primary_rating", "secondary_rating", "adult_text", "adult_voice", "companion_confirmed"] },
        "status": { "enum": ["observed", "inferred", "confirmed", "corrected", "rejected"] },
        "independenceRating": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "fact": { "$ref": "#/$defs/localizedString" },
        "context": { "$ref": "#/$defs/observationContext" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "revision": { "type": "integer", "minimum": 1 },
        "supersedesObservationId": { "type": ["string", "null"] },
        "correctionReason": { "type": ["string", "null"] },
        "rejectionReason": { "type": ["string", "null"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "enum": ["primary_rating", "secondary_rating"] } }, "required": ["source"] },
          "then": { "properties": { "independenceRating": { "type": "integer", "minimum": 1, "maximum": 5 } } },
          "else": { "properties": { "independenceRating": { "type": "null" } } }
        },
        {
          "if": { "properties": { "source": { "const": "adult_voice" } }, "required": ["source"] },
          "then": { "properties": { "provenance": { "type": "object", "properties": { "inputRef": { "type": "string", "minLength": 1 } } } } }
        },
        {
          "if": { "properties": { "status": { "const": "corrected" } }, "required": ["status"] },
          "then": {
            "properties": {
              "supersedesObservationId": { "type": "string", "pattern": "^OBS-[A-Z0-9-]+$" },
              "correctionReason": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "rejected" } }, "required": ["status"] },
          "then": { "properties": { "rejectionReason": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "evidenceLink": {
      "type": "object", "additionalProperties": false, "required": ["observationId", "relationship", "contextNote"],
      "properties": {
        "observationId": { "type": "string", "pattern": "^OBS-[A-Z0-9-]+$" },
        "relationship": { "enum": ["supporting", "contradicting", "context_only"] },
        "contextNote": { "type": ["string", "null"] }
      }
    },
    "inference": {
      "type": "object", "additionalProperties": false,
      "required": ["inferenceId", "skillId", "state", "confidence", "evidenceLinks", "explanation", "updatedAt", "lastEvidenceAt", "confirmationState", "revision", "supersedesInferenceId", "correctionReason", "ruleVersion"],
      "properties": {
        "inferenceId": { "type": "string", "pattern": "^INF-[A-Z0-9-]+$" },
        "skillId": { "type": "string", "minLength": 1 },
        "state": { "enum": ["not_enough_evidence", "exploring", "developing", "consolidating"] },
        "confidence": { "enum": ["insufficient", "initial", "moderate", "strong"] },
        "evidenceLinks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceLink" } },
        "explanation": { "$ref": "#/$defs/localizedString" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastEvidenceAt": { "type": ["string", "null"], "format": "date-time" },
        "confirmationState": { "enum": ["auto_updated", "adult_confirmed", "adult_corrected", "rejected"] },
        "revision": { "type": "integer", "minimum": 1 },
        "supersedesInferenceId": { "type": ["string", "null"] },
        "correctionReason": { "type": ["string", "null"] },
        "ruleVersion": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "not_enough_evidence" } }, "required": ["state"] },
          "then": {
            "properties": { "confidence": { "const": "insufficient" }, "evidenceLinks": { "type": "array", "maxItems": 0 }, "lastEvidenceAt": { "type": "null" } }
          },
          "else": {
            "properties": { "confidence": { "enum": ["initial", "moderate", "strong"] }, "evidenceLinks": { "type": "array", "minItems": 1 }, "lastEvidenceAt": { "type": "string", "format": "date-time" } }
          }
        },
        {
          "if": { "properties": { "confirmationState": { "enum": ["adult_corrected", "rejected"] } }, "required": ["confirmationState"] },
          "then": { "properties": { "correctionReason": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "revision": { "type": "integer", "minimum": 2 } }, "required": ["revision"] },
          "then": { "properties": { "supersedesInferenceId": { "type": "string", "pattern": "^INF-[A-Z0-9-]+$" } } }
        }
      ]
    }
  }
}
