{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kids-learning.local/schemas/v0.1/offline-pack-manifest.schema.json",
  "title": "OfflinePackManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "manifestVersion", "manifestContentHash", "familyId", "planId", "generatedAt", "expiresAt", "baseServerRevision", "activityEntries", "sessionAssignments", "assets"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "packId": { "type": "string", "pattern": "^PACK-[A-Z0-9-]+$" },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "manifestContentHash": { "$ref": "#/$defs/sha256" },
    "familyId": { "type": "string", "minLength": 1 },
    "planId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "baseServerRevision": { "type": "integer", "minimum": 0 },
    "activityEntries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/activityEntry" } },
    "sessionAssignments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sessionAssignment" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "activityEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["activityId", "version", "schemaVersion", "contentHash", "locale", "safetyParticipationLevel"],
      "properties": {
        "activityId": { "type": "string", "pattern": "^ACT-[0-9]{4}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "schemaVersion": { "const": "0.1" },
        "contentHash": { "$ref": "#/$defs/sha256" },
        "locale": { "enum": ["en-US", "es-US"] },
        "safetyParticipationLevel": { "enum": ["A", "B", "C", "D"] }
      }
    },
    "sessionAssignment": {
      "type": "object", "additionalProperties": false,
      "required": ["sessionId", "activityId", "activityVersion", "learnerId", "roleTemplateId", "primaryObjectiveSkillId"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^SES-[A-Z0-9-]+$" },
        "activityId": { "type": "string", "pattern": "^ACT-[0-9]{4}$" },
        "activityVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "learnerId": { "type": "string", "minLength": 1 },
        "roleTemplateId": { "type": "string", "pattern": "^ROLE-[A-Z0-9-]+$" },
        "primaryObjectiveSkillId": { "type": "string", "minLength": 1 }
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "activityId", "activityVersion", "contentHash", "mediaType", "byteSize"],
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "activityId": { "type": "string", "pattern": "^ACT-[0-9]{4}$" },
        "activityVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "contentHash": { "$ref": "#/$defs/sha256" },
        "mediaType": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" },
        "byteSize": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
