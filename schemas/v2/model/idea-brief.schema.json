{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kids-learning.example/schemas/v2/model/idea-brief.schema.json",
  "title": "IdeaBrief",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "promise", "fit", "area", "mechanism", "materials", "safety", "sourceRefs"],
  "properties": {
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "promise": { "type": "string", "minLength": 10, "maxLength": 240 },
    "fit": {
      "type": "object", "additionalProperties": false, "required": ["age", "group", "minutes", "risk"],
      "properties": {
        "age": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 5, "maximum": 10 }, { "type": "integer", "minimum": 5, "maximum": 10 }], "minItems": 2, "maxItems": 2 },
        "group": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 4 } },
        "minutes": { "type": "integer", "minimum": 5, "maximum": 90 },
        "risk": { "enum": ["A", "B", "C"] }
      }
    },
    "area": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "mechanism": { "type": "string", "minLength": 3, "maxLength": 160 },
    "materials": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
    "safety": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 3, "maxLength": 180 } },
    "sourceRefs": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 100 } }
  }
}
