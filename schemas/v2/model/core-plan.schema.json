{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kids-learning.example/schemas/v2/model/core-plan.schema.json",
  "title": "CorePlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "method", "skills", "states", "steps", "risks"],
  "properties": {
    "goal": { "type": "string", "minLength": 10, "maxLength": 300 },
    "method": { "type": "string", "minLength": 10, "maxLength": 400 },
    "skills": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "maxLength": 100 } },
    "states": {
      "type": "array", "minItems": 2, "maxItems": 12,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "meaning"], "properties": { "id": { "type": "string", "maxLength": 60 }, "meaning": { "type": "string", "maxLength": 240 } } }
    },
    "steps": {
      "type": "array", "minItems": 2, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "entry", "exit", "actor", "action", "purpose", "signal"],
        "properties": {
          "id": { "type": "string", "maxLength": 60 }, "entry": { "type": "string", "maxLength": 60 }, "exit": { "type": "string", "maxLength": 60 },
          "actor": { "enum": ["adult", "child", "group", "role"] },
          "action": { "type": "string", "minLength": 3, "maxLength": 300 },
          "purpose": { "type": "string", "minLength": 3, "maxLength": 300 },
          "signal": { "type": "string", "minLength": 3, "maxLength": 240 }
        }
      }
    },
    "risks": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["hazard", "control", "stop", "steps"],
        "properties": {
          "hazard": { "type": "string", "maxLength": 200 }, "control": { "type": "string", "maxLength": 240 },
          "stop": { "type": "string", "maxLength": 240 },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 60 } }
        }
      }
    }
  }
}
