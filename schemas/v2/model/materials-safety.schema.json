{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kids-learning.example/schemas/v2/model/materials-safety.schema.json",
  "title": "MaterialsSafetyDraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["materials", "safety"],
  "properties": {
    "materials": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "quantity", "unit", "required", "reusable", "prep", "safety", "substitutes"],
        "properties": {
          "id": {"type": "string", "minLength": 2, "maxLength": 60},
          "name": {"type": "string", "minLength": 1, "maxLength": 100},
          "quantity": {"type": "number", "exclusiveMinimum": 0},
          "unit": {"type": "string", "minLength": 1, "maxLength": 30},
          "required": {"type": "boolean"},
          "reusable": {"type": "boolean"},
          "prep": {"type": "string", "minLength": 1, "maxLength": 240},
          "safety": {"type": "string", "minLength": 1, "maxLength": 240},
          "substitutes": {
            "type": "array", "maxItems": 4,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "name", "quantity", "unit", "conditions", "rationale", "safety"],
              "properties": {
                "id": {"type": "string", "minLength": 2, "maxLength": 60},
                "name": {"type": "string", "minLength": 1, "maxLength": 100},
                "quantity": {"type": "number", "exclusiveMinimum": 0},
                "unit": {"type": "string", "minLength": 1, "maxLength": 30},
                "conditions": {"type": "string", "minLength": 1, "maxLength": 240},
                "rationale": {"type": "string", "minLength": 1, "maxLength": 240},
                "safety": {"enum": ["none", "reviewed", "reviewed_equivalent"]}
              }
            }
          }
        }
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "supervision", "hazards", "stops", "prohibited", "cleanup"],
      "properties": {
        "level": {"enum": ["A", "B", "C"]},
        "supervision": {"type": "string", "minLength": 3, "maxLength": 300},
        "hazards": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "category", "description", "controls", "stepIds"],
            "properties": {
              "id": {"type": "string", "minLength": 2, "maxLength": 60},
              "category": {"type": "string", "minLength": 2, "maxLength": 60},
              "description": {"type": "string", "minLength": 3, "maxLength": 240},
              "controls": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "minLength": 3, "maxLength": 240}},
              "stepIds": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 60}}
            }
          }
        },
        "stops": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 3, "maxLength": 240}},
        "prohibited": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 3, "maxLength": 240}},
        "cleanup": {"type": "string", "minLength": 3, "maxLength": 240}
      }
    }
  }
}
