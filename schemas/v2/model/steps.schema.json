{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kids-learning.example/schemas/v2/model/steps.schema.json",
  "title": "StepsDraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps"],
  "properties": {
    "steps": {
      "type": "array", "minItems": 2, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "stage", "minutes", "title", "instruction", "adultActions", "prompts", "participantActions", "materialIds", "observable", "problems", "resume"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 60},
          "stage": {"enum": ["discover", "imagine", "build_or_do", "experiment", "improve", "explain", "close", "cleanup"]},
          "minutes": {"type": "integer", "minimum": 1, "maximum": 45},
          "title": {"type": "string", "minLength": 2, "maxLength": 100},
          "instruction": {"type": "string", "minLength": 3, "maxLength": 360},
          "adultActions": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 2, "maxLength": 240}},
          "prompts": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 2, "maxLength": 240}},
          "participantActions": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 2, "maxLength": 240}},
          "materialIds": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 60}},
          "decision": {"type": "string", "minLength": 2, "maxLength": 240},
          "observable": {"type": "string", "minLength": 2, "maxLength": 240},
          "problems": {
            "type": "array", "maxItems": 4,
            "items": {"type": "object", "additionalProperties": false, "required": ["problem", "safeResponse"], "properties": {"problem": {"type": "string", "maxLength": 160}, "safeResponse": {"type": "string", "maxLength": 240}}}
          },
          "warning": {"type": "string", "minLength": 2, "maxLength": 240},
          "resume": {"type": "string", "minLength": 2, "maxLength": 240}
        }
      }
    }
  }
}
