{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kids-learning.example/schemas/v2/model/roles-adaptations.schema.json",
  "title": "RolesAdaptationsDraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["roles", "groups", "adaptations"],
  "properties": {
    "roles": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "levels", "skills", "allowedSteps", "restrictedSteps", "contribution", "responsibilities"],
        "properties": {
          "id": {"type": "string", "minLength": 2, "maxLength": 60},
          "name": {"type": "string", "minLength": 2, "maxLength": 100},
          "levels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["L1", "L2", "L3", "L4"]}},
          "skills": {"type": "array", "maxItems": 5, "items": {"type": "string", "maxLength": 100}},
          "allowedSteps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "maxLength": 60}},
          "restrictedSteps": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 60}},
          "contribution": {"type": "string", "minLength": 3, "maxLength": 240},
          "responsibilities": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "maxLength": 240}}
        }
      }
    },
    "groups": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {"type": "object", "additionalProperties": false, "required": ["size", "roles", "notes"], "properties": {"size": {"type": "integer", "minimum": 1, "maximum": 4}, "roles": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "maxLength": 60}}, "notes": {"type": "string", "minLength": 2, "maxLength": 240}}}
    },
    "adaptations": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "safety", "adultConfirm", "name", "conditions", "changes"],
        "properties": {
          "id": {"type": "string", "minLength": 2, "maxLength": 60},
          "type": {"enum": ["presentation", "difficulty", "role", "material", "duration", "simplification", "extension"]},
          "safety": {"enum": ["none", "reviewed"]},
          "adultConfirm": {"type": "boolean"},
          "name": {"type": "string", "minLength": 2, "maxLength": 100},
          "conditions": {"type": "string", "minLength": 2, "maxLength": 240},
          "changes": {"type": "string", "minLength": 2, "maxLength": 360}
        }
      }
    }
  }
}
