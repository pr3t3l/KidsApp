{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kids-learning.example/schemas/v2/read-models/session-step.schema.json",
  "title": "SessionStep",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "activityVersion", "stepId", "position", "total", "blocks", "canPause"],
  "properties": {
    "sessionId": { "type": "string", "format": "uuid" }, "activityVersion": { "type": "string" }, "stepId": { "type": "string" },
    "position": { "type": "integer", "minimum": 1 }, "total": { "type": "integer", "minimum": 1 },
    "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "../content-block.schema.json" } },
    "canPause": { "type": "boolean" }
  }
}
